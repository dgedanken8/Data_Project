#include "xparameters.h"
#include "xaxidma.h"
#include "xil_cache.h"
#include "xil_printf.h"
#include "xstatus.h"
#include "sleep.h"

/* AXI DMA instance generated by Vivado/SDK. */
#define DMA_DEVICE_ID       XPAR_AXI_DMA_0_DEVICE_ID

/*
 * Use a DDR area sufficiently far from the beginning of DDR,
 * where the application, stack and heap are normally located.
 *
 * DDR begins at 0x00100000, so this buffer is at 0x01100000.
 */
#define RX_BUFFER_BASE      \
    (XPAR_PS7_DDR_0_S_AXI_BASEADDR + 0x01000000U)

/* Packet: Header + Length + 6 Data words + Checksum. */
#define PACKET_WORDS        9U
#define TRANSFER_BYTES      (PACKET_WORDS * sizeof(u32))

/*
 * Poll once every millisecond, for up to 60 seconds.
 * This gives enough time to press BTN0 after the DMA is ready.
 */
#define DMA_TIMEOUT_COUNT   60000U

static XAxiDma AxiDma;

/* Expected packet produced by the RTL chain. */
static const u32 ExpectedPacket[PACKET_WORDS] = {
    0xA5A50001U,  /* Header */
    0x00000006U,  /* Length */
    0x00000001U,  /* Data[0] */
    0x00000007U,  /* Data[1] */
    0x00000008U,  /* Data[2] */
    0x00000003U,  /* Data[3] */
    0x00000006U,  /* Data[4] */
    0x00000003U,  /* Data[5] */
    0x0000001CU   /* Checksum = 28 */
};

static int InitializeDma(void)
{
    XAxiDma_Config *DmaConfig;
    int Status;

    DmaConfig = XAxiDma_LookupConfig(DMA_DEVICE_ID);

    if (DmaConfig == NULL) {
        xil_printf("ERROR: AXI DMA configuration was not found.\r\n");
        return XST_FAILURE;
    }

    Status = XAxiDma_CfgInitialize(&AxiDma, DmaConfig);

    if (Status != XST_SUCCESS) {
        xil_printf("ERROR: AXI DMA initialization failed.\r\n");
        return XST_FAILURE;
    }

    /*
     * Our hardware was configured in Simple Mode.
     * Scatter/Gather must therefore be disabled.
     */
    if (XAxiDma_HasSg(&AxiDma)) {
        xil_printf("ERROR: DMA is configured in Scatter/Gather mode.\r\n");
        return XST_FAILURE;
    }

    /*
     * We use polling instead of interrupts in this first hardware test.
     * Only the receive direction exists in our DMA configuration.
     */
    XAxiDma_IntrDisable(
        &AxiDma,
        XAXIDMA_IRQ_ALL_MASK,
        XAXIDMA_DEVICE_TO_DMA
    );

    return XST_SUCCESS;
}

static void ClearReceiveBuffer(volatile u32 *RxBuffer)
{
    u32 Index;

    for (Index = 0U; Index < PACKET_WORDS; Index++) {
        RxBuffer[Index] = 0U;
    }

    /*
     * Flush dirty cache lines before the DMA writes to DDR.
     * This prevents an old cached value from later overwriting DMA data.
     */
    Xil_DCacheFlushRange(
        (UINTPTR)RxBuffer,
        TRANSFER_BYTES
    );
}

static int WaitForDmaCompletion(void)
{
    u32 Timeout = DMA_TIMEOUT_COUNT;

    while (XAxiDma_Busy(&AxiDma, XAXIDMA_DEVICE_TO_DMA)) {
        if (Timeout == 0U) {
            xil_printf("ERROR: DMA receive timeout.\r\n");
            return XST_FAILURE;
        }

        usleep(1000U);
        Timeout--;
    }

    return XST_SUCCESS;
}

static int VerifyPacket(volatile u32 *RxBuffer)
{
    u32 Index;
    int ErrorCount = 0;

    /*
     * The DMA changed DDR directly, not through the CPU cache.
     * Invalidate the cached copy before the CPU reads the packet.
     */
    Xil_DCacheInvalidateRange(
        (UINTPTR)RxBuffer,
        TRANSFER_BYTES
    );

    xil_printf("\r\nReceived packet:\r\n");

    for (Index = 0U; Index < PACKET_WORDS; Index++) {
        xil_printf(
            "Word %d: received = 0x%08x, expected = 0x%08x\r\n",
            (int)Index,
            (unsigned int)RxBuffer[Index],
            (unsigned int)ExpectedPacket[Index]
        );

        if (RxBuffer[Index] != ExpectedPacket[Index]) {
            ErrorCount++;
        }
    }

    if (ErrorCount != 0) {
        xil_printf("\r\nTEST FAILED: %d incorrect word(s).\r\n",
                   ErrorCount);
        return XST_FAILURE;
    }

    xil_printf("\r\nTEST PASSED: AXI DMA wrote the packet to DDR.\r\n");
    return XST_SUCCESS;
}

int main(void)
{
    volatile u32 *RxBuffer;
    int Status;

    RxBuffer = (volatile u32 *)RX_BUFFER_BASE;

    xil_printf("\r\n");
    xil_printf("============================================\r\n");
    xil_printf("Data Project - AXI DMA to DDR Test\r\n");
    xil_printf("RX buffer address: 0x%08x\r\n",
               (unsigned int)RX_BUFFER_BASE);
    xil_printf("Transfer size: %d bytes\r\n",
               (int)TRANSFER_BYTES);
    xil_printf("============================================\r\n");

    Status = InitializeDma();

    if (Status != XST_SUCCESS) {
        xil_printf("TEST FAILED: DMA initialization error.\r\n");

        while (1) {
            /* Stop here after a fatal initialization error. */
        }
    }

    xil_printf("AXI DMA initialized successfully.\r\n");

    ClearReceiveBuffer(RxBuffer);

    /*
     * Arm the S2MM receive channel before pressing the button.
     * After this call, the DMA is ready to accept AXI-Stream data.
     */
    Status = XAxiDma_SimpleTransfer(
        &AxiDma,
        (UINTPTR)RxBuffer,
        TRANSFER_BYTES,
        XAXIDMA_DEVICE_TO_DMA
    );

    if (Status != XST_SUCCESS) {
        xil_printf("TEST FAILED: Could not start S2MM transfer.\r\n");

        while (1) {
            /* Stop here after failure to arm the DMA. */
        }
    }

    xil_printf("\r\nDMA is ready to receive 36 bytes.\r\n");
    xil_printf("Press BTN0 briefly to start the RTL packet.\r\n");

    Status = WaitForDmaCompletion();

    if (Status == XST_SUCCESS) {
        (void)VerifyPacket(RxBuffer);
    } else {
        xil_printf("TEST FAILED: Packet was not received.\r\n");
    }

    while (1) {
        /* Keep the final result visible in the SDK Terminal. */
    }

    return 0;
}
